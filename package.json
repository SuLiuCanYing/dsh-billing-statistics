{
  "name": "llm-usage-insights",
  "version": "1.3.3",
  "private": true,
  "license": "MIT",
  "description": "按平台与模型统计模型 API 的调用次数、token 与花费（价格从平台官网同步，含峰谷价），并在侧栏提供入口页面。",
  "type": "module",
  "icon": "icon.svg",
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "pricing.js",
    "price-source.js",
    "usage-store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
